# Environment Variables
# Copy this file to .env and fill in your actual credentials

# Database configuration (optional - defaults to SQLite for local development)
# Non-sensitive values (host, db name, port) are hardcoded in settings.py
# Only the password needs to be set here.
#
# Users:
#   - hom_app: Runtime user (camera_configs read-only) - default
#   - hom_migrate: Migration user (DDL privileges) - use for migrations
#   - hom_infra: Infra project user (camera_configs write-only)
#
# For production/CI:
DATABASE_PASSWORD=your_neon_password_here
DATABASE_USER=hom_app

# Camera credentials
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_password_here

# Example usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace placeholders with your actual values
# 3. The .env file should NOT be committed to git (it's in .gitignore)
# 4. Or run: ./scripts/generate-env.sh to fetch from Bitwarden
